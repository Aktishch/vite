{% set data = {
  title: 'My library',
  status: true
} %}
{% extends 'src/layouts/base.njk' %}
{% block content %}
{% import 'src/components/title.njk' as title %}
{% import 'src/components/subtitle.njk' as subtitle %}

{# My library #}

<section class="wrapper flex flex-col items-center justify-center bg-white dark:bg-black min-h-125 xl:min-h-150" id="header">
  {{ image.render(src = '/img/pictures/logo', format = 'svg', className = 'w-full max-w-2xl mb-10', data = 'data-anim') }}
  {{ title.render(text = 'Main block', className = 'mb-5 sm:mb-10', data = 'data-anim data-movement="blend"') }}
  <div class="w-full max-w-48" data-anim>
    <a class="btn btn-primary btn-fill btn-lg w-full" data-waved="light" data-scroll-to draggable="false" href="#content">Show more</a>
  </div>
</section>

{# Статьи #}

<section class="wrapper xl:wrapper-distance flex flex-col items-center justify-center bg-grey dark:bg-dark" data-listing="1" id="content">
  {{ subtitle.render(text = 'Cards', className = 'mb-3', data = 'data-anim data-movement="blend"') }}
  <h3 class="font-semibold sm:text-lg mb-5 sm:mb-10" data-anim data-movement="blend">
    Construction and effect
  </h3>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 xl:gap-8 w-full mb-5 sm:md-10">
    {% for i in range(1, 4) %}
    <div data-anim>
      <article class="card dark:bg-black shadow-md transition-shadow hover:shadow-xl">
        <div class="aspect-4/3 relative bg-grey dark:bg-dark rounded-t-inherit overflow-hidden" data-media data-movement="light">
          {{ loader.render() }}
          {{ image.render(src = '/', className = 'media rounded-t-inherit', data = 'data-lazy data-src="/img/pictures/test.jpg"') }}
        </div>
        <div class="card-content py-6 px-4 md:px-6">
          <h4 class="font-alt font-semibold text-2xl/tight mb-4">
            Article
            {{ i }}
          </h4>
          <p class="text-justify text-sm sm:text-base mb-5">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Numquam repudiandae maxime quia culpa, est voluptatum hic at ipsa error officiis magni dolores molestiae inventore ipsum perferendis reiciendis sunt nesciunt possimus?
          </p>
          <button class="btn btn-primary btn-fill btn-lg mt-auto" data-waved="light">Button</button>
        </div>
      </article>
    </div>
    {% endfor %}
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 xl:gap-8 w-full">
    {% for i in range(1, 4) %}
    <div class="sm:block duration-500 anim anim-up" data-anim data-listing-item>
      <article class="inverted h-full">
        <div class="inverted-before">
          <div class="card dark:bg-black shadow-md transition-shadow hover:shadow-xl">
            <div class="aspect-4/2 relative bg-grey dark:bg-dark rounded-t-inherit overflow-hidden" data-media>
              {{ loader.render() }}
              {{ image.render(src = '/', className = 'media rounded-t-inherit', data = 'data-lazy data-src="/img/pictures/test.jpg"') }}
            </div>
            <div class="card-content py-6 px-4 sm:px-6">
              <h4 class="font-alt font-semibold text-2xl">
                Article
                {{ i }}
              </h4>
            </div>
          </div>
        </div>
        <div class="inverted-after">
          <div class="card dark:bg-black shadow-md transition-shadow hover:shadow-xl">
            <div class="card-content py-6 px-4 sm:px-6">
              <h4 class="font-alt font-semibold text-2xl mb-4">
                Article
                {{ i }}
              </h4>
              <p class="text-justify text-sm sm:text-base mb-5">
                Lorem ipsum dolor sit amet consectetur adipisicing elit. Numquam repudiandae maxime quia culpa, est voluptatum hic at ipsa error officiis magni dolores molestiae inventore ipsum perferendis reiciendis sunt nesciunt possimus? Lorem ipsum dolor sit amet consectetur adipisicing elit.
              </p>
              <button class="btn btn-primary btn-fill btn-lg mt-auto" data-waved="light">Button</button>
            </div>
          </div>
        </div>
      </article>
    </div>
    {% endfor %}
  </div>
  <div class="w-full max-w-48" data-anim>
    <button class="btn btn-second btn-fade btn-lg sm:hidden w-full mt-5" data-listing-show data-waved="dark">Show more</button>
  </div>
</section>

{% endblock %}