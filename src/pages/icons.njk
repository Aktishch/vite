{% set data = {
  title: 'Icons',
  status: false
} %}

{% extends 'src/layouts/base.njk' %}

{% block content %}

{# Icons #}

{% set icons = ['loader', 'burger', 'close', 'success', 'basket', 'search', 'like', 'calendar', 'star', 'arrow-left', 'arrow-right', 'arrows', 'arrow-bottom', 'eye-visible', 'eye-hidden', 'file', 'user', 'ok', 'yt', 'inst', 'fb', 'tw', 'vk', 'play', 'pause', 'arrow-prev', 'arrow-next', 'volume-on', 'volume-off', 'loading', 'trash'] %}

<section class="wrapper grow">
  <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-3 gap-y-6">
    {% for item in icons %}
    <li class="flex items-center">
      {{ icon.render(id = item, className = 'icon mr-2') }}
      id:
      {{ item }}
    </li>
    {% endfor %}
  </ul>
</section>

{% endblock %}